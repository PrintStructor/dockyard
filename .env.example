# Printer nginx origin (e.g. Mainsail on port 80): Moonraker APIs + /webcam and /webcam2.
# Replace with your printer address. Keep .env.local private.
PRINTER_URL=http://127.0.0.1
# Display name of your printer shown as a badge next to the DOCKYARD brand.
# Leave empty (PRINTER_NAME=) to hide the printer badge.
PRINTER_NAME=STORMTROOPER
# Browser navigation link to Mainsail. Must be reachable from the browser.
# Set to "auto" (or omit) when hosting on the printer itself to derive http(s)://<current-host>/.
VITE_MAINSAIL_URL=http://127.0.0.1/

# Optional standalone production server settings (`npm start`):
# Bind host and port (defaults to loopback 127.0.0.1:4173).
# HOST=0.0.0.0
# PORT=4173
# Comma-separated explicit LAN origins allowed to issue control POST requests.
# Example: ALLOWED_ORIGINS=http://printer.local:4173,http://192.0.2.10:4173
# ALLOWED_ORIGINS=

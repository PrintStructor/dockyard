# Example systemd user service for running DOCKYARD Touch HMI (800x480)
# as a lightweight KlipperScreen / HelixScreen replacement on a Raspberry Pi 5" LCD.
#
# Install on the printer Pi:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/dockyard-kiosk.service.example ~/.config/systemd/user/dockyard-kiosk.service
#   # Adjust --printer=<id> and URL to match your DOCKYARD host & printer profile ID
#   systemctl --user daemon-reload
#   systemctl --user enable --now dockyard-kiosk.service
#
# Tip: Disable KlipperScreen first if installed:
#   sudo systemctl disable --now KlipperScreen

[Unit]
Description=DOCKYARD 800x480 Touch HMI Kiosk
After=network-online.target graphical-session.target dockyard.service
Wants=network-online.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# Pin this display strictly to one printer (?printer=<id>), lock kiosk chrome (?lock=1),
# hide cursor (?cursor=0), and enable 5-minute idle screensaver (?sleep=300).
ExecStart=/usr/bin/chromium-browser \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --check-for-update-interval=31536000 \
  --disable-session-crashed-bubble \
  --autoplay-policy=no-user-gesture-required \
  --window-size=800,480 \
  --window-position=0,0 \
  "http://127.0.0.1:4173/?touch=1&printer=stormtrooper&lock=1&cursor=0&sleep=300"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
